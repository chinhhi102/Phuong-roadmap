{
  "name": "ba-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BA Academy — an interactive learning platform to become a job-ready Business Analyst.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "server": "node server/index.mjs",
    "dev:server": "node server/index.mjs & vite --mode server",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.17.0",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.441.0",
    "mermaid": "^11.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
